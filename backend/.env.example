# PianoScribe AI backend settings (copy to .env). All are optional.

# Transcription engine: bytedance | basic_pitch | external_cli
PIANOSCRIBE_TRANSCRIPTION_ENGINE=bytedance

# Torch device for the ByteDance model: cpu | mps | cuda | auto
# (On an M2, CPU measured slightly faster than MPS for this model.)
PIANOSCRIBE_TORCH_DEVICE=cpu

# Run any CLI transcriber that writes MIDI ({input} = WAV, {output} = .mid)
# PIANOSCRIBE_EXTERNAL_CLI_COMMAND="transkun {input} {output}"

# Where uploads, results, the database and model checkpoints live
# PIANOSCRIBE_DATA_DIR=./data

# Run the worker inside the API process instead of separately
# PIANOSCRIBE_EMBEDDED_WORKER=false

# Optional tools
# PIANOSCRIBE_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# PIANOSCRIBE_MUSESCORE_PATH="/Applications/MuseScore 4.app/Contents/MacOS/mscore"

# PIANOSCRIBE_MAX_UPLOAD_MB=2048
